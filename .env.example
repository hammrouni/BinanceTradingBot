# --- BINANCE API CREDENTIALS ---

# 1. Market Data (Always Production API keys)
# Required for high-fidelity RSI signals even on Testnet
PROD_BINANCE_API_KEY=REMOVED_API_KEY
PROD_BINANCE_API_SECRET=REMOVED_API_SECRET

# 2. Trading (Testnet OR Live API keys)
# Use Testnet for practice, Live for real money
TEST_BINANCE_API_KEY=REMOVED_API_KEY
TEST_BINANCE_API_SECRET=REMOVED_API_SECRET
# --- GLOBAL SETTINGS ---

# Choose environment: 'testnet' or 'live'
TRADING_ENV=live

# AI Agent Service (Ollama / OpenAI-compatible)
AGENT_SERVICE_URL=http://agent-service
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_PROVIDER=openai
LLM_API_KEY=groq