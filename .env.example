# Copy to .env and fill in your own values. NEVER commit .env or real keys.
# Create Binance keys with "Enable Reading" + "Enable Spot Trading" only.
# Never enable withdrawals. Restrict keys to your IP when possible.

# --- 1. MARKET DATA (always Binance PRODUCTION) ---
# Read-only access is enough. Used for prices, klines, RSI and the "real portfolio" wallet view.
PROD_BINANCE_API_KEY=your_prod_api_key
PROD_BINANCE_API_SECRET=your_prod_api_secret

# --- 2. TRADING (where orders are placed) ---
# Testnet keys: https://testnet.binance.vision
TEST_BINANCE_API_KEY=your_testnet_api_key
TEST_BINANCE_API_SECRET=your_testnet_api_secret

# Live trading keys (optional). If empty and TRADING_ENV=live, PROD keys are used.
LIVE_BINANCE_API_KEY=
LIVE_BINANCE_API_SECRET=

# --- 3. GLOBAL SETTINGS ---
# 'testnet' (practice, default) or 'live' (REAL MONEY)
TRADING_ENV=testnet

# Initial pair for the market-data stream. The stream follows pair changes made in the dashboard.
TRADING_PAIR=BTCUSDT

# Optional: require this token (X-Dashboard-Token header or cookie) on /api/v1/*, /ws/dashboard, /mcp.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# Internal SearXNG metasearch secret (docker-compose, no host port). The compose default
# is a known constant — override it in your .env before any deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEARXNG_SECRET=

# After a restart a bot that was RUNNING comes back PAUSED (safe default). Set true to resume trading automatically.
RESTORE_RUNNING_ON_RESTART=false

# --- 4. AI (chat endpoint + PHP agent service) ---
# Any OpenAI-compatible endpoint: Ollama, Groq, OpenAI...
AGENT_SERVICE_URL=http://agent-service
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_PROVIDER=openai
LLM_API_KEY=ollama
LLM_TIMEOUT=600
LLM_MAX_TOKENS=16384
# Agents ask the LLM server for a JSON object (response_format). Set 0 if your server rejects it.
LLM_JSON_MODE=1
