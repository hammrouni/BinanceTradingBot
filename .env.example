# --- BINANCE API CREDENTIALS ---

# 1. Market Data (Always Production API keys)
# Required for high-fidelity RSI signals even on Testnet
PROD_BINANCE_API_KEY=your_prod_key_here
PROD_BINANCE_API_SECRET=your_prod_secret_here

# 2. Trading (Testnet OR Live API keys)
# Use Testnet for practice, Live for real money
TEST_BINANCE_API_KEY=your_testnet_key_here
TEST_BINANCE_API_SECRET=your_testnet_secret_here

LIVE_BINANCE_API_KEY=
LIVE_BINANCE_API_SECRET=

# --- GLOBAL SETTINGS ---

# Choose environment: 'testnet' or 'live'
TRADING_ENV=testnet
