{
    "name": "binancetradingbot/agent-service",
    "description": "NanoAgentPHP AI Agents for BinanceTradingBot",
    "type": "project",
    "repositories": [],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "hammrouni/nanoagent": "^0.5"
